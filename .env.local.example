# Kopiere diese Datei zu .env.local und trage dort deine echten Keys ein.
# .env.local wird nicht eingecheckt (siehe .gitignore).

# Kursdaten (Aktien, Gold, Rohstoffe) – z.B. Twelve Data oder Finnhub
MARKET_DATA_API_KEY=

# Fundamentaldaten – z.B. Financial Modeling Prep oder Finnhub
FUNDAMENTALS_API_KEY=

# Finanznachrichten – z.B. Finnhub News oder Marketaux
NEWS_API_KEY=

# KI-Research-Assistent – Google Gemini (aistudio.google.com, kostenlos)
GEMINI_API_KEY=
